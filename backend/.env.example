# Base de datos SQLite (ruta relativa a backend/)
# Para reducir bloqueos concurrentes se recomienda connection_limit=1
DATABASE_URL="file:./dev.db?connection_limit=1"

# Puerto del servidor API
PORT=3000

# Origenes permitidos para CORS (separados por coma). Vacio = permitir todos en desarrollo.
# CORS_ORIGIN=http://localhost:5173

# Servir el frontend compilado desde el mismo servidor (produccion local)
# SERVE_FRONTEND=true

# Autenticacion local. Dejar activada salvo desarrollo local aislado.
AUTH_ENABLED=true

# Secreto HMAC para firmar tokens. OBLIGATORIO en produccion.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=genera-un-secreto-largo-y-aleatorio

# Detrás de un proxy inverso (nginx, Docker, Railway...) seteá la cantidad de
# saltos de confianza para que el rate-limit vea la IP real del cliente.
# Ej.: TRUST_PROXY=1 (un proxy) o TRUST_PROXY=loopback
# TRUST_PROXY=1

# Logging
# Nivel: debug | info | warn | error
LOG_LEVEL=info
# Escribir logs a backend/logs/ (ademas de stdout)
LOG_TO_FILE=true
